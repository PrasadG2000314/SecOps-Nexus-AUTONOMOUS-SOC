# ==============================================================================
# SecOps-Nexus Environment Configuration Template
# COPY THIS FILE TO '.env' AND FILL IN YOUR SECURE CREDENTIALS.
# NEVER COMMIT YOUR REAL '.env' FILE TO SOURCE CONTROL!
# ==============================================================================

# Operational Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=false

# API Server Binding (use 127.0.0.1 for local isolation)
HOST=127.0.0.1
PORT=8000

# Zero-Trust HMAC Webhook Secret (Generate with: openssl rand -hex 32)
# In production, this is strictly required and must be kept confidential.
WEBHOOK_HMAC_SECRET=your_secure_random_64_character_hex_hmac_secret_here

# Google Gemini Security Reasoning Engine
# Get an API key from Google AI Studio: https://aistudio.google.com/
# Leave blank to use built-in deterministic heuristic security reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Privileged Access Management (PAM) - HashiCorp Vault / CyberArk
# Set PAM_SIMULATION_MODE=false to enable real Vault API integration
PAM_SIMULATION_MODE=true
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# Safety & Autonomous Containment Thresholds
# Contextual risk score limit for autonomous fixes without human sign-off (0-100)
AUTO_CONTAINMENT_MAX_RISK=30.0

# PAM Ephemeral Token Validity Window in Seconds (default 300s = 5 minutes)
EPHEMERAL_TOKEN_TTL_SECONDS=300

# Orchestrator & Distributed Mode (true = zero-dependency standalone async)
STANDALONE_MODE=true
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
